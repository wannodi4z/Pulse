{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Operational Pulse · local Mac",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["server:app", "--host", "127.0.0.1", "--port", "5510"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {"PULSE_TIMEZONE": "America/Mexico_City"}
    }
  ]
}
